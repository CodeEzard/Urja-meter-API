{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops Clean API",
    "description": "Production-grade, typed REST API wrapper over the legacy Urja Meter Ops portal. Normalizes meter telemetry, calculates 30-minute interval consumption deltas, and reconstructs the electrical distribution grid hierarchy.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service health check",
        "description": "Check the health of the API service, cache sync state, and upstream portal connectivity.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Trigger cache synchronization",
        "description": "Force a sync of meters and transformers metadata from the upstream portal.",
        "operationId": "trigger_sync_api_v1_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and filter smart meters",
        "description": "Retrieve a paginated list of smart meters with optional filtering by query, DT code, phase, status, or make.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free text search across ID, serial number, make, or DT code",
              "title": "Q"
            },
            "description": "Free text search across ID, serial number, make, or DT code"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Distribution Transformer code (e.g. DT-001)",
              "title": "Dt Code"
            },
            "description": "Filter by Distribution Transformer code (e.g. DT-001)"
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase: single or three",
              "title": "Phase"
            },
            "description": "Filter by phase: single or three"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by operational status: Installed, Faulty, Decommissioned",
              "title": "Status"
            },
            "description": "Filter by operational status: Installed, Faulty, Decommissioned"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Secure, Allied)",
              "title": "Make"
            },
            "description": "Filter by meter manufacturer (e.g. HPL, L&T, Genus, Secure, Allied)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page (max 100)",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_MeterSummary_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter details",
        "description": "Retrieve full details for a single meter, including normalized geo coordinates and full 7-level electrical hierarchy.",
        "operationId": "get_meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get interval energy consumption",
        "description": "Retrieve 30-minute interval readings for a meter. Calculates delta active consumption (kWh) per interval and provides aggregate statistics.",
        "operationId": "get_meter_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date in YYYY-MM-DD format (e.g., 2026-06-25)",
              "title": "From"
            },
            "description": "Start date in YYYY-MM-DD format (e.g., 2026-06-25)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date in YYYY-MM-DD format (e.g., 2026-06-26)",
              "title": "To"
            },
            "description": "End date in YYYY-MM-DD format (e.g., 2026-06-26)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "List distribution transformers",
        "description": "Retrieve distribution transformers (DTs), including capacity, feeder association, and count of connected meters.",
        "operationId": "list_transformers_api_v1_transformers_get",
        "parameters": [
          {
            "name": "feeder_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by upstream feeder code (e.g. F-001)",
              "title": "Feeder Code"
            },
            "description": "Filter by upstream feeder code (e.g. F-001)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DistributionTransformer"
                  },
                  "title": "Response List Transformers Api V1 Transformers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers/{code}": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "Get transformer details",
        "description": "Retrieve details for a specific distribution transformer, including all assigned meter IDs.",
        "operationId": "get_transformer_api_v1_transformers__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistributionTransformerDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "Hierarchy"
        ],
        "summary": "Get distribution grid hierarchy",
        "description": "Retrieve the complete reconstructed electrical grid hierarchy from Zone down to Feeder, Transformer, and Meters.",
        "operationId": "get_grid_hierarchy_api_v1_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Grid Hierarchy Api V1 Hierarchy Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionSummary": {
        "properties": {
          "total_consumption_kwh": {
            "type": "number",
            "title": "Total Consumption Kwh",
            "description": "Total active energy consumed over the queried period in kWh"
          },
          "max_interval_kwh": {
            "type": "number",
            "title": "Max Interval Kwh",
            "description": "Peak interval consumption in kWh"
          },
          "min_interval_kwh": {
            "type": "number",
            "title": "Min Interval Kwh",
            "description": "Lowest interval consumption in kWh"
          },
          "average_voltage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Voltage",
            "description": "Average R-phase voltage across all intervals"
          },
          "reading_count": {
            "type": "integer",
            "title": "Reading Count",
            "description": "Number of interval readings received"
          }
        },
        "type": "object",
        "required": [
          "total_consumption_kwh",
          "max_interval_kwh",
          "min_interval_kwh",
          "reading_count"
        ],
        "title": "ConsumptionSummary"
      },
      "Coordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "Latitude in decimal degrees",
            "example": 26.938961
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "Longitude in decimal degrees",
            "example": 75.830957
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinates"
      },
      "DistributionTransformer": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique transformer code",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Transformer location/name",
            "example": "Malviya Nagar DT 1"
          },
          "feeder_code": {
            "type": "string",
            "title": "Feeder Code",
            "description": "Upstream feeder code",
            "example": "F-001"
          },
          "capacity_kva": {
            "type": "number",
            "title": "Capacity Kva",
            "description": "Rated transformer capacity in kVA",
            "example": 100.0
          },
          "assigned_meters_count": {
            "type": "integer",
            "title": "Assigned Meters Count",
            "description": "Total meters connected to this transformer",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "feeder_code",
          "capacity_kva"
        ],
        "title": "DistributionTransformer"
      },
      "DistributionTransformerDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique transformer code",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Transformer location/name",
            "example": "Malviya Nagar DT 1"
          },
          "feeder_code": {
            "type": "string",
            "title": "Feeder Code",
            "description": "Upstream feeder code",
            "example": "F-001"
          },
          "capacity_kva": {
            "type": "number",
            "title": "Capacity Kva",
            "description": "Rated transformer capacity in kVA",
            "example": 100.0
          },
          "assigned_meters_count": {
            "type": "integer",
            "title": "Assigned Meters Count",
            "description": "Total meters connected to this transformer",
            "default": 0
          },
          "meter_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Meter Ids",
            "description": "IDs of all meters assigned to this DT"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "feeder_code",
          "capacity_kva"
        ],
        "title": "DistributionTransformerDetail"
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "End of 30-minute interval in ISO-8601 IST (+05:30)",
            "example": "2026-06-25T00:30:00+05:30"
          },
          "kwh_reading": {
            "type": "number",
            "title": "Kwh Reading",
            "description": "Cumulative active energy register reading in kWh",
            "example": 48459.87
          },
          "kvah_reading": {
            "type": "number",
            "title": "Kvah Reading",
            "description": "Cumulative apparent energy register reading in kVAh",
            "example": 52336.66
          },
          "consumption_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumption Kwh",
            "description": "Calculated energy consumption during this 30-minute interval (kWh)",
            "example": 0.42
          },
          "voltage_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voltage R",
            "description": "R-phase voltage in volts",
            "example": 222.0
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "kwh_reading",
          "kvah_reading"
        ],
        "title": "EnergyReading"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds"
          },
          "portal_authenticated": {
            "type": "boolean",
            "title": "Portal Authenticated"
          },
          "cached_meters_count": {
            "type": "integer",
            "title": "Cached Meters Count"
          },
          "cached_transformers_count": {
            "type": "integer",
            "title": "Cached Transformers Count"
          },
          "last_sync_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "uptime_seconds",
          "portal_authenticated",
          "cached_meters_count",
          "cached_transformers_count"
        ],
        "title": "HealthResponse"
      },
      "HierarchyNode": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Identifier code for this node",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable name",
            "example": "Malviya Nagar DT 1"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "HierarchyNode"
      },
      "MeterConsumptionResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "from_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Date"
          },
          "to_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Date"
          },
          "summary": {
            "$ref": "#/components/schemas/ConsumptionSummary"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "summary",
          "readings"
        ],
        "title": "MeterConsumptionResponse"
      },
      "MeterDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique meter identifier",
